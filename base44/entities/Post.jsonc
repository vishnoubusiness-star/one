{
  "name": "Post",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_username": {
      "type": "string"
    },
    "author_photo": {
      "type": "string"
    },
    "college": {
      "type": "string",
      "default": "Georgia Tech"
    },
    "content": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "none"
      ],
      "default": "none"
    },
    "likes_count": {
      "type": "integer",
      "default": 0
    },
    "comments_count": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "content"
  ]
}
