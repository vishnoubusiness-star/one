    },
    "type": {
      "type": "string",
      "enum": [
        "like",
        "comment",
        "follow",
        "achievement",
        "pr"
      ]
    },
    "content": {
      "type": "string"
    },
    "related_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
